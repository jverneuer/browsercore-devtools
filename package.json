{
    "name": "@browsercore/devtools",
    "version": "0.1.4",
    "description": "Developer tooling — packet inspector, TLS/HTTP2 visualizer, profile diff, certificate inspector, benchmark CLI.",
    "repository": {
        "type": "git",
        "url": "https://github.com/jverneuer/browsercore-devtools.git"
    },
    "homepage": "https://github.com/jverneuer/browsercore-devtools#readme",
    "bugs": {
        "url": "https://github.com/jverneuer/browsercore-devtools/issues"
    },
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "network-devtools": "./dist/cli.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "clean": "rm -rf dist",
        "build": "tsc -p tsconfig.build.json",
        "prepublishOnly": "npm run clean && npm run build",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "lint": "oxlint --type-aware src/"
    },
    "devDependencies": {
        "@types/node": "^26.1.2",
        "@vitest/coverage-v8": "^4.1.10",
        "oxlint": "^1.76.0",
        "oxlint-tsgolint": "7.0.2001",
        "typescript": "^7.0.0",
        "vitest": "^4.1.10"
    },
    "engines": {
        "node": ">=26.0.0"
    },
    "dependencies": {
        "@browsercore/cookies": "0.1.5",
        "@browsercore/crypto": "0.1.4",
        "@browsercore/fetch": "0.1.3",
        "@browsercore/http1": "0.1.4",
        "@browsercore/http2": "0.1.4",
        "@browsercore/profiles": "0.1.4",
        "@browsercore/testing": "file:../testing",
        "@browsercore/tls": "0.1.3",
        "@browsercore/transport": "0.1.3"
    }
}
